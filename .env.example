# Triibe Platform — environment variables
# Local dev: copy to `.env` (loaded by server/env.js). On Vercel: set these in
# Project Settings -> Environment Variables (do NOT commit real secrets).

# REQUIRED — Postgres connection string from Supabase
# (Supabase dashboard -> Project Settings -> Database -> Connection string / URI,
#  with your DB password filled in). Use the pooled connection string on Vercel.
DATABASE_URL=postgres://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# pg pool size — keep small on serverless to avoid exhausting Supabase connections
PG_POOL_MAX=5

# OPTIONAL — OpenAI (AI drafts/parsing). Stays OFF until the `ai_enabled` config
# kill switch is flipped to 'true', so a key alone never incurs charges.
OPENAI_API_KEY=
AI_ENABLED=false

# Build flag (set on Vercel) — skip Chromium download during npm install, since
# the whatsapp-web.js dependency is only used by the off-Vercel daemon.
PUPPETEER_SKIP_DOWNLOAD=true

# OPTIONAL — legacy snapshot ingestion source (only if importing old ~/triibe-ops
# data). Unset in normal operation.
# TRIIBE_OPS=/path/to/triibe-ops

# OPTIONAL — WhatsApp bridge dir, used by tools/wa-sync.js on the DAEMON box only
# (the WhatsApp daemon runs off-Vercel and writes to the same Supabase DB).
# WA_BRIDGE_DIR=/path/to/triibe-ops/whatsapp-bridge
