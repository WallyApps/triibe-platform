# Local database (regenerable from migration)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Private brand briefs + contract attachments auto-downloaded from Gmail
# (PDFs of paid-deal scopes — never commit)
data/email-media/

# WhatsApp media downloads — voice notes, images, attachments from brand WA chats
data/wa-media/

# Secrets / API keys — NEVER commit
.env
.env.*
config/secrets.json

# Snapshot copy of live deals (private, transient, read-only mirror of ~/triibe-ops)
migration/source/*.json

# Contracts (private legal docs)
contracts/*.pdf
contracts/*.docx
contracts/*.doc

# OS / editor
.DS_Store
node_modules/
*.log

# Banking + payee details — NEVER commit
config/payment_info.json

# Gmail OAuth tokens — NEVER commit (contain refresh_token = full inbox access)
credentials/
credentials/*.json

# whatsapp-web.js cache (browser HTML snapshots, regenerable)
.wwebjs_cache/

# whatsapp-web.js auth session (would also leak account, though we use bridge path now)
.wwebjs_auth/

# Migration tooling output
cook_all.mjs.log

# Baileys WhatsApp auth session (creds.json + signal keys = full WA account access)
# NEVER commit — these let anyone replay your authenticated session
whatsapp-daemon/baileys-auth/
